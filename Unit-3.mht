@charset "utf-8";

:root { --ink: #0B1220; --ink-2: #111B2B; --paper: #EBF1F3; --card: #FFFFFF; --line: #D6E0E4; --amber: #F5A623; --amber-dim: #8A6420; --teal: #1FB6A6; --crimson: #E4572E; --text: #101820; --muted: #5B6B76; --mono: 'JetBrains Mono', monospace; --display: 'Space Grotesk', sans-serif; --body: 'IBM Plex Sans', sans-serif; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { font-family: var(--body); background: var(--paper); color: var(--text); line-height: 1.65; }

a { color: inherit; }

.shell { display: grid; grid-template-columns: 280px 1fr; min-height: 100vh; }

.rail { position: sticky; top: 0px; height: 100vh; background: var(--ink); color: rgb(220, 230, 234); padding: 32px 0px; overflow-y: auto; border-right: 1px solid rgb(28, 42, 61); }

.rail-brand { padding: 0px 28px 24px; border-bottom: 1px solid rgb(28, 42, 61); margin-bottom: 8px; }

.rail-brand .tag { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; color: var(--amber); text-transform: uppercase; }

.rail-brand h1 { font-family: var(--display); font-size: 22px; font-weight: 700; margin-top: 6px; line-height: 1.25; color: rgb(242, 246, 247); }

.rail-brand p { font-size: 12.5px; color: rgb(143, 161, 172); margin-top: 8px; }

.line-group { padding: 18px 0px 6px; }

.line-label { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(92, 113, 130); padding: 8px 28px 10px; }

.stop { position: relative; display: flex; align-items: flex-start; gap: 14px; padding: 9px 28px 9px 24px; text-decoration: none; cursor: pointer; }

.stop::before { content: ""; position: absolute; left: 32px; top: -4px; bottom: -4px; width: 2px; background: rgb(40, 56, 76); }

.stop:first-child::before { top: 50%; }

.stop:last-child::before { bottom: 50%; }

.dot { position: relative; z-index: 2; width: 10px; height: 10px; border-radius: 50%; background: rgb(40, 56, 76); border: 2px solid var(--ink); margin-top: 5px; flex-shrink: 0; transition: 0.25s; }

.stop span.label { font-size: 13.5px; color: rgb(159, 176, 187); transition: color 0.25s; }

.stop:hover span.label { color: rgb(220, 230, 234); }

.stop.active .dot { background: var(--amber); box-shadow: rgba(245, 166, 35, 0.18) 0px 0px 0px 4px; }

.stop.active span.label { color: var(--amber); font-weight: 600; }

main { padding: 0px; }

.hero { padding: 88px 64px 64px; background: radial-gradient(circle at 85% 20%, rgba(245,166,35,.10), transparent 45%),
      var(--ink); color: rgb(242, 246, 247); position: relative; overflow: hidden; }

.hero .kicker { font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber); }

.hero h1 { font-family: var(--display); font-weight: 700; font-size: clamp(34px, 4.4vw, 58px); line-height: 1.08; margin-top: 18px; max-width: 16ch; }

.hero p.lede { margin-top: 22px; max-width: 62ch; font-size: 16.5px; color: rgb(174, 192, 202); }

.route-strip { margin-top: 44px; display: flex; align-items: center; flex-wrap: wrap; gap: 0px; }

.route-strip .node { font-family: var(--mono); font-size: 11.5px; color: rgb(220, 230, 234); background: rgb(22, 35, 58); border: 1px solid rgb(36, 52, 74); padding: 7px 13px; border-radius: 999px; white-space: nowrap; }

.route-strip .seg { width: 22px; height: 1px; background: rgb(46, 65, 87); flex-shrink: 0; }

.content { padding: 0px 64px 120px; max-width: 920px; }

section.topic { padding: 72px 0px; border-bottom: 1px solid var(--line); scroll-margin-top: 24px; }

section.topic:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.topic-eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--amber-dim); display: flex; align-items: center; gap: 10px; }

.topic-eyebrow .num { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: var(--ink); color: var(--amber); font-size: 11.5px; }

.topic h2 { font-family: var(--display); font-size: clamp(26px, 3vw, 36px); font-weight: 700; margin-top: 14px; color: var(--text); }

.topic h3 { font-family: var(--display); font-size: 19px; font-weight: 600; margin-top: 34px; margin-bottom: 10px; color: var(--ink); }

.topic p { margin-top: 14px; font-size: 15.5px; color: rgb(49, 66, 76); max-width: 72ch; }

.topic ul, .topic ol { margin-top: 14px; padding-left: 22px; max-width: 72ch; }

.topic li { font-size: 15.5px; color: rgb(49, 66, 76); margin-top: 8px; }

.topic li strong { color: var(--text); }

code.inline { font-family: var(--mono); background: rgb(220, 230, 233); color: rgb(14, 76, 70); padding: 2px 7px; border-radius: 5px; font-size: 0.88em; }

.callout { margin-top: 22px; padding: 16px 20px; border-left: 3px solid var(--teal); background: rgb(228, 245, 242); border-radius: 0px 8px 8px 0px; font-size: 14.5px; color: rgb(14, 76, 70); max-width: 72ch; }

.callout.warn { border-left-color: var(--crimson); background: rgb(251, 233, 227); color: rgb(122, 42, 18); }

.callout b { display: block; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; }

.code-card { margin-top: 20px; background: rgb(11, 18, 32); border-radius: 12px; overflow: hidden; box-shadow: rgba(11, 18, 32, 0.18) 0px 8px 24px; }

.code-head { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; background: rgb(17, 27, 43); border-bottom: 1px solid rgb(28, 42, 61); }

.code-head .fname { font-family: var(--mono); font-size: 12px; color: rgb(143, 161, 172); }

.code-head .dots { display: flex; gap: 6px; }

.code-head .dots span { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }

.code-head .dots span:nth-child(1) { background: rgb(228, 87, 46); }

.code-head .dots span:nth-child(2) { background: rgb(245, 166, 35); }

.code-head .dots span:nth-child(3) { background: rgb(31, 182, 166); }

.code-card pre { margin: 0px; padding: 18px 20px; overflow-x: auto; font-family: var(--mono); font-size: 13px; line-height: 1.6; background: transparent !important; }

.compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 20px; }

.compare-card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 20px; }

.compare-card h4 { font-family: var(--display); font-size: 15.5px; display: flex; align-items: center; gap: 8px; }

.compare-card h4 .chip { width: 8px; height: 8px; border-radius: 50%; }

.compare-card.a h4 .chip { background: var(--amber); }

.compare-card.b h4 .chip { background: var(--teal); }

.compare-card p { margin-top: 8px; font-size: 14px; }

.compare-card ul { margin-top: 10px; padding-left: 18px; }

.compare-card li { font-size: 13.5px; margin-top: 6px; }

table.ref { width: 100%; margin-top: 20px; border-collapse: collapse; font-size: 14px; background: var(--card); border-radius: 10px; overflow: hidden; box-shadow: 0 1px 0 var(--line); }

table.ref th { text-align: left; background: var(--ink); color: rgb(220, 230, 234); font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; padding: 12px 16px; }

table.ref td { padding: 12px 16px; border-bottom: 1px solid var(--line); color: rgb(49, 66, 76); vertical-align: top; }

table.ref tr:last-child td { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

table.ref td code { font-family: var(--mono); background: rgb(220, 230, 233); color: rgb(14, 76, 70); padding: 1px 6px; border-radius: 4px; font-size: 0.85em; }

.badge-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; }

.badge { font-family: var(--mono); font-size: 11.5px; padding: 6px 12px; border-radius: 999px; background: var(--ink); color: var(--amber); border: 1px solid rgb(28, 42, 61); }

footer { padding: 48px 64px 64px; background: var(--ink); color: rgb(143, 161, 172); font-size: 13px; }

footer .fname { color: rgb(220, 230, 234); font-family: var(--display); font-size: 16px; margin-bottom: 6px; }

@media (max-width: 860px) {
  .shell { grid-template-columns: 1fr; }
  .rail { position: relative; height: auto; }
  .hero, .content, footer { padding-left: 24px; padding-right: 24px; }
  .compare-grid { grid-template-columns: 1fr; }
}
